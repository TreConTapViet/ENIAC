rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Supports both Firebase Auth UID and OTP-verified custom session IDs (otp_...)
    function isValidAccountOwner(id) {
      return isOwner(id) ||
        (id is string && id.size() >= 8 && id.size() <= 128 && id.matches('^otp_[a-zA-Z0-9_\\-]+$'));
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'email', 'gender', 'favoriteStyles',
        'accentColor', 'themeMode', 'onboardingCompleted', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'email', 'gender', 'favoriteStyles',
        'accentColor', 'themeMode', 'avatarUrl',
        'heightCm', 'weightKg', 'bustCm', 'waistCm', 'hipCm',
        'onboardingCompleted',
        'cloudinaryCloudName', 'cloudinaryUploadPreset',
        'emailjsServiceId', 'emailjsTemplateId', 'emailjsPublicKey',
        'passwordHash', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && isValidAccountOwner(data.uid) && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
      data.gender is string && data.gender in ['Nữ', 'Nam', 'Khác'] &&
      data.favoriteStyles is list && data.favoriteStyles.size() <= 15 &&
      (data.favoriteStyles.size() == 0 || (data.favoriteStyles[0] is string && data.favoriteStyles[0].size() <= 60)) &&
      data.accentColor is string && data.accentColor in ['amber', 'rose', 'emerald', 'indigo', 'violet', 'slate'] &&
      data.themeMode is string && data.themeMode in ['light', 'dark'] &&
      data.onboardingCompleted is bool &&
      (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 350000)) &&
      (!('heightCm' in data) || (data.heightCm is number && data.heightCm >= 100 && data.heightCm <= 250)) &&
      (!('weightKg' in data) || (data.weightKg is number && data.weightKg >= 25 && data.weightKg <= 250)) &&
      (!('bustCm' in data) || (data.bustCm is number && data.bustCm >= 40 && data.bustCm <= 200)) &&
      (!('waistCm' in data) || (data.waistCm is number && data.waistCm >= 35 && data.waistCm <= 200)) &&
      (!('hipCm' in data) || (data.hipCm is number && data.hipCm >= 40 && data.hipCm <= 200)) &&
      (!('cloudinaryCloudName' in data) || (data.cloudinaryCloudName is string && data.cloudinaryCloudName.size() <= 100)) &&
      (!('cloudinaryUploadPreset' in data) || (data.cloudinaryUploadPreset is string && data.cloudinaryUploadPreset.size() <= 100)) &&
      (!('emailjsServiceId' in data) || (data.emailjsServiceId is string && data.emailjsServiceId.size() <= 100)) &&
      (!('emailjsTemplateId' in data) || (data.emailjsTemplateId is string && data.emailjsTemplateId.size() <= 100)) &&
      (!('emailjsPublicKey' in data) || (data.emailjsPublicKey is string && data.emailjsPublicKey.size() <= 100)) &&
      (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() == 64)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: WardrobeItem
    function isValidWardrobeItem(data) {
      return data.keys().hasAll([
        'userId', 'name', 'category', 'styleTag', 'color',
        'season', 'occasion', 'imageUrl', 'favorite', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'name', 'category', 'styleTag', 'color',
        'season', 'occasion', 'imageUrl', 'favorite', 'createdAt', 'updatedAt'
      ]) &&
      data.userId is string && isValidAccountOwner(data.userId) && data.userId.size() >= 1 && data.userId.size() <= 128 &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
      data.category is string && data.category in ['Áo', 'Quần & Chân váy', 'Áo khoác', 'Giày dép', 'Phụ kiện'] &&
      data.styleTag is string && data.styleTag.size() >= 1 && data.styleTag.size() <= 60 &&
      data.color is string && data.color.size() >= 1 && data.color.size() <= 50 &&
      data.season is string && data.season in ['Mọi thời tiết', 'Nắng ấm', 'Mát mẻ', 'Se lạnh', 'Mưa'] &&
      data.occasion is string && data.occasion in ['Đi làm / Đi học', 'Dạo phố / Cafe', 'Tiệc tối / Hẹn hò', 'Thể thao / Vận động', 'Du lịch'] &&
      data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000 &&
      data.favorite is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: SavedOutfit
    function isValidSavedOutfit(data) {
      return data.keys().hasAll([
        'userId', 'title', 'occasion', 'weatherNote', 'items', 'auraAdvice', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'title', 'occasion', 'weatherNote', 'items', 'auraAdvice', 'createdAt'
      ]) &&
      data.userId is string && isValidAccountOwner(data.userId) && data.userId.size() >= 1 && data.userId.size() <= 128 &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.occasion is string && data.occasion.size() >= 1 && data.occasion.size() <= 60 &&
      data.weatherNote is string && data.weatherNote.size() >= 1 && data.weatherNote.size() <= 120 &&
      data.items is list && data.items.size() >= 1 && data.items.size() <= 8 &&
      data.items[0] is string && data.items[0].size() <= 120 &&
      data.auraAdvice is string && data.auraAdvice.size() >= 1 && data.auraAdvice.size() <= 800 &&
      data.createdAt is timestamp;
    }

    // Connection test path (read-only for connection verification)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && isValidAccountOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isValidAccountOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isValidAccountOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'gender', 'favoriteStyles', 'accentColor', 'themeMode',
          'avatarUrl', 'heightCm', 'weightKg', 'bustCm', 'waistCm', 'hipCm',
          'onboardingCompleted', 'cloudinaryCloudName', 'cloudinaryUploadPreset',
          'emailjsServiceId', 'emailjsTemplateId', 'emailjsPublicKey', 'passwordHash', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isValidAccountOwner(userId);
    }

    // Wardrobe Items Collection
    match /wardrobeItems/{itemId} {
      allow get: if isValidId(itemId) && isValidAccountOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(itemId) &&
        isValidWardrobeItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));
      allow update: if isValidId(itemId) &&
        isValidWardrobeItem(incoming()) &&
        isValidAccountOwner(existing().userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['favorite', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'category', 'styleTag', 'color', 'season', 'occasion', 'imageUrl', 'favorite', 'updatedAt'
          ])
        );
      allow delete: if isValidId(itemId) && isValidAccountOwner(existing().userId);
    }

    // Saved Outfits Collection
    match /savedOutfits/{outfitId} {
      allow get: if isValidId(outfitId) && isValidAccountOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(outfitId) &&
        isValidSavedOutfit(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().userId));
      allow update: if false;
      allow delete: if isValidId(outfitId) && isValidAccountOwner(existing().userId);
    }
  }
}
