# Sao chép thành .env.local rồi điền key từ https://aistudio.google.com/apikey
GEMINI_API_KEY=
# PORT=3000

# APP_URL: địa chỉ host ứng dụng (AI Studio tự điền khi chạy trên Cloud Run)
# APP_URL=

# (Tuỳ chọn) EmailJS để gửi mã OTP đăng ký thật qua email — dùng ở WardrobeDoorAuth
VITE_EMAILJS_SERVICE_ID="service_zpohl0g"
VITE_EMAILJS_TEMPLATE_ID="template_j43mlzm"
VITE_EMAILJS_PUBLIC_KEY="qoUpfXhovg5EA3Pm6"

# (Tuỳ chọn) Cloudinary để lưu ảnh tủ đồ trên mây
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Firebase của Smart Wardrobe (project smart-wardrobe-79480). Lấy ở Firebase Console →
# Project settings → Your apps → Web app → SDK setup and configuration → Config.
# Bắt buộc: thiếu VITE_FIREBASE_API_KEY / PROJECT_ID / APP_ID thì app báo lỗi khi khởi động.
# Không commit key thật; .env.local đã nằm trong .gitignore.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="smart-wardrobe-79480.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="smart-wardrobe-79480"
VITE_FIREBASE_STORAGE_BUCKET="smart-wardrobe-79480.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Database mặc định là "(default)"
VITE_FIREBASE_DATABASE_ID="(default)"
